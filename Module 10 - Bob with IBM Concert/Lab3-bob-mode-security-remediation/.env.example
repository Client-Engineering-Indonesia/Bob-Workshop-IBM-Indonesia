# IBM Concert API Configuration
# Copy this file to .env and fill in your Concert credentials

# Required: Your Concert instance URL
CONCERT_BASE_URL=https://your-concert-instance.ibm.com

# Required: Your Concert API key
# Get this from Concert UI → Settings → API Keys
CONCERT_API_KEY=your_api_key_here

# Security Settings
AUTO_APPROVE_FIXES=false        # Require human approval before applying fixes
CVSS_THRESHOLD=7.0              # Only handle High/Critical vulnerabilities (7.0+)
MAX_FIXES_PER_SESSION=5         # Safety limit on concurrent fixes