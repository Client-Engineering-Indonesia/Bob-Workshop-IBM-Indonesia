# ============================================================
# IBM Concert API Configuration — Workshop Template
# ============================================================
# INSTRUKSI:
#   1. Copy file ini: cp .env.example .env
#   2. Isi nilai CONCERT_BASE_URL, CONCERT_API_KEY, dan CONCERT_INSTANCE_ID
#      dengan credentials yang dibagikan oleh presenter saat workshop
#   3. Simpan file .env (jangan di-commit ke GitHub!)
# ============================================================

# Required: Concert instance URL (akan diberikan oleh presenter)
# Format: https://<host>:<port>/concert/core/api/v1
CONCERT_BASE_URL=<AKAN_DIBERIKAN_PRESENTER>

# Required: Concert API Key (akan diberikan oleh presenter)
# Format: base64-encoded string dari "username:apikey"
CONCERT_API_KEY=<AKAN_DIBERIKAN_PRESENTER>

# Required: Concert Instance ID (akan diberikan oleh presenter)
# Biasanya: 0000-0000-0000-0000
CONCERT_INSTANCE_ID=<AKAN_DIBERIKAN_PRESENTER>
